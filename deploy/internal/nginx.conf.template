# Re-resolve Docker service names after API/tusd container recreation.
resolver 127.0.0.11 valid=5s ipv6=off;
resolver_timeout 2s;
upstream portal_api {
    zone portal_api 64k;
    server api:8000 resolve;
}
upstream portal_tusd {
    zone portal_tusd 64k;
    server tusd:1080 resolve;
}

server {
    listen 8080;
    server_name _;
    access_log off;
    client_max_body_size 33m;
    client_body_timeout 300s;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;

    location = /_upload_auth {
        internal;
        proxy_pass http://portal_api/internal/upload-auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $portal_upload_method;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Upload-Metadata $http_upload_metadata;
        proxy_set_header Upload-Length $http_upload_length;
        proxy_set_header Upload-Defer-Length $http_upload_defer_length;
        proxy_set_header Upload-Concat $http_upload_concat;
        proxy_set_header X-CSRF-Token $http_x_csrf_token;
        proxy_set_header X-Portal-Hook-Secret ${PORTAL_HOOK_SECRET};
    }
    location ^~ /internal/ { return 404; }
    location ^~ /uploads/ {
        set $portal_upload_method $request_method;
        if ($request_method !~ ^(POST|PATCH|HEAD|OPTIONS)$) { return 405; }
        auth_request /_upload_auth;
        proxy_pass http://portal_tusd;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Portal-Hook-Secret ${PORTAL_HOOK_SECRET};
    }
    location / {
        client_max_body_size 8m;
        proxy_pass http://portal_api;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Portal-Hook-Secret "";
    }
}
