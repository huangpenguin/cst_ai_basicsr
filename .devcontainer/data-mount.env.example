# Shell profile snippet — NOT auto-loaded by Dev Containers.
#
# Copy exports to ~/.zshrc or ~/.bashrc, or run before Rebuild Container.

# Shared raw datasets (autofs → /mnt/data)
export DATA_MOUNT_SOURCE=/mnt/data

# All users' home dirs (autofs → /mnt/home); container sees /home/<username>
export HOME_MOUNT_SOURCE=/mnt/home

# Personal writable root inside the container (change <username> for other devs)
export WORK_DIR=/home/huang

# Project slug — raw data at /data/$PROJECT_NAME, outputs at $WORK_DIR/$PROJECT_NAME
export PROJECT_NAME=cst_ai

# Optional overrides (container absolute paths)
# export DATASET_DIR=/data/cst_ai/data_0607/260520_1-battery_data/260520_battery image tiff data
# export OUTPUT_DIR=/home/huang/cst_ai/outputs/local-run
