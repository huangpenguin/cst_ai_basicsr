{
  "name": "BasicSR GPU",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "dev",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "initializeCommand": "test -n \"${localEnv:DATA_MOUNT_SOURCE}\" && test -d \"${localEnv:DATA_MOUNT_SOURCE}\" || (echo 'ERROR: export DATA_MOUNT_SOURCE before Rebuild (e.g. /mnt/data).' >&2 && exit 1)",
  "containerEnv": {
    "PYTHONUNBUFFERED": "1",
    "UV_LINK_MODE": "copy",
    "UV_CACHE_DIR": "/workspace/.cache/uv",
    "DATA_DIR": "/data",
    "PROJECT_NAME": "cst_ai"
  },
  "postCreateCommand": "bash scripts/uv-bootstrap.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
        "python.terminal.activateEnvironment": false,
        "remote.containers.copyGitConfig": false
      }
    }
  }
}
